<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

<!-- ============================================== -->
  <!-- pfSense Custom SOC Rules                       -->
  <!-- ============================================== -->

  <!-- Phase 1: pfSense WebGUI Login Failures -->
<rule id="100010" level="8">
    <if_sid>70000</if_sid>
    <match>webConfigurator authentication error</match>
    <description>pfSense: WebGUI Failed Login Attempt.</description>
    <group>authentication_failed, pci_dss_10.2.4,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- Phase 2: pfSense Firewall Drops -->
<rule id="100011" level="5">
    <program_name>filterlog</program_name>
    <match>block</match>
    <description>pfSense: Firewall blocked network traffic.</description>
    <group>firewall_drop, pci_dss_1.3.3,</group>
  </rule>

</group>
